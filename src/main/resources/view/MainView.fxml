<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.text.Font?>
<!---->
<BorderPane prefHeight="720.0" prefWidth="1280.0" styleClass="root-pane" stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.MainController">
    <top>
        <HBox fx:id="barraJanela" alignment="CENTER_RIGHT" maxHeight="38.0" minHeight="-Infinity" minWidth="-Infinity"
              prefHeight="38.0" style="-fx-background-color: #181c27;" stylesheets="@style.css" onMousePressed="#aoPressionarMouse" onMouseDragged="#aoArrastarMouse">
            <children>
                <HBox prefHeight="38.0" prefWidth="13.0"/>
                <Label text="EcoWallet" textFill="WHITE">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </Label>
                <HBox prefHeight="100.0" prefWidth="200.0" HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER_RIGHT" spacing="5.0" HBox.hgrow="NEVER">
                    <children>
                        <Button onAction="#minimizarJanela" fx:id="btnMinimizarJanela" accessibleText="Minimizar" mnemonicParsing="false" styleClass="btn-window">
                            <graphic>
                                <FontIcon iconLiteral="remixmz-subtract-fill" iconSize="16" iconColor="ghostwhite"/>
                            </graphic>
                        </Button>
                        <Button onAction="#maximizarJanela" fx:id="btnMaximizarJanela" accessibleText="Maximizar" mnemonicParsing="false" styleClass="btn-window">
                            <graphic>
                                <FontIcon fx:id="maximizeIcon" iconLiteral="remixal-checkbox-blank-line" iconSize="16"
                                          iconColor="ghostwhite"/>
                            </graphic>
                        </Button>
                        <Button onAction="#fecharJanela" fx:id="btnFecharJanela" accessibleText="Fechar" mnemonicParsing="false">
                            <styleClass>
                                <String fx:value="btn-window"/>
                                <String fx:value="close-window"/>
                            </styleClass>
                            <graphic>
                                <FontIcon iconLiteral="remixal-close-fill" iconSize="16" iconColor="ghostwhite"/>
                            </graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
        </HBox>
    </top>
    <left>
        <VBox prefWidth="220" styleClass="sidebar">

            <!-- Logo / Título -->
            <VBox alignment="CENTER" styleClass="sidebar-header">
                <ImageView fitWidth="128" fitHeight="128" fx:id="logo" preserveRatio="true"/>
                <Label styleClass="app-subtitle" text="Controle Financeiro"/>
            </VBox>

            <!-- Separador -->
            <Separator styleClass="sidebar-separator"/>

            <!-- Navegação -->
            <VBox styleClass="nav-section" VBox.vgrow="ALWAYS">
                <Label styleClass="nav-section-label" text="NAVEGAÇÃO"/>
                <Button fx:id="btnDashboard" maxWidth="Infinity" styleClass="nav-btn, nav-btn-active" text="Dashboard">
                    <graphic>
                        <FontIcon iconLiteral="remixal-dashboard-fill" iconSize="24" iconColor="ghostwhite"/>
                    </graphic>
                </Button>
                <!--                <Button fx:id="btnNovaTransacao" maxWidth="Infinity" styleClass="nav-btn" text="➕  Nova Transação" />-->
                <!--                <Button fx:id="btnHistorico" maxWidth="Infinity" styleClass="nav-btn" text="📋  Histórico" />-->
                <!--                <Button fx:id="btnCategorias" maxWidth="Infinity" styleClass="nav-btn" text="📁  Categorias" />-->
            </VBox>

            <!-- Rodapé da sidebar -->
            <VBox styleClass="sidebar-footer">
                <Separator styleClass="sidebar-separator"/>
                <Label styleClass="version-label" text="v1.0.0  •  POO 2026"/>
            </VBox>

            <VBox.margin>
                <Insets/>
            </VBox.margin>
        </VBox>
    </left>

    <center>
        <!-- ── SCROLL PANE ADICIONADO AQUI ── -->
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">

            <VBox spacing="20" styleClass="main-content">
                <padding>
                    <Insets bottom="28" left="32" right="32" top="28"/>
                </padding>

                <!-- ── Cabeçalho ── -->
                <HBox alignment="CENTER_LEFT" spacing="16" styleClass="page-header">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="lblPageTitle" styleClass="page-title" text="Dashboard"/>
                        <Label styleClass="page-desc" text="Bem-vindo de volta! Aqui está seu resumo financeiro."/>
                    </VBox>
                    <Button fx:id="btnAddTransacao" onAction="#handleAddTransacao" styleClass="btn-primary"
                            text="Adicionar">
                        <graphic>
                            <FontIcon iconLiteral="remixal-add-fill" iconSize="24" iconColor="black"/>
                        </graphic>
                    </Button>
                </HBox>

                <!-- ── Cards de Resumo ── -->
                <HBox spacing="16">

                    <!-- Card Saldo -->
                    <VBox spacing="8" styleClass="summary-card, card-saldo" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label styleClass="card-icon" text=""/>
                            <Label styleClass="card-label" text="SALDO TOTAL"/>
                        </HBox>
                        <Label fx:id="lblSaldoTotal" styleClass="card-value, value-saldo" text="R$ 0,00"/>
                        <Label fx:id="lblSaldoInfo" styleClass="card-hint" text="Atualizado agora"/>
                    </VBox>

                    <!-- Card Receitas -->
                    <VBox spacing="8" styleClass="summary-card, card-receita" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label styleClass="card-icon" text=""/>
                            <Label styleClass="card-label" text="RECEITAS"/>
                        </HBox>
                        <Label fx:id="lblTotalReceitas" styleClass="card-value, value-receita" text="R$ 0,00"/>
                        <Label fx:id="lblQtdReceitas" styleClass="card-hint" text="0 transações"/>
                    </VBox>

                    <!-- Card Despesas -->
                    <VBox spacing="8" styleClass="summary-card, card-despesa" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label styleClass="card-icon" text=""/>
                            <Label styleClass="card-label" text="DESPESAS"/>
                        </HBox>
                        <Label fx:id="lblTotalDespesas" styleClass="card-value, value-despesa" text="R$ 0,00"/>
                        <Label fx:id="lblQtdDespesas" styleClass="card-hint" text="0 transações"/>
                    </VBox>

                </HBox>

                <!-- ── Formulário de Nova Transação ── -->
                <VBox fx:id="formPanel" spacing="14" styleClass="form-card">
                    <Label styleClass="section-title" text="Nova Transação"/>

                    <HBox alignment="CENTER_LEFT" spacing="12">

                        <!-- Tipo -->
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="Tipo"/>
                            <ComboBox fx:id="cbTipo" maxWidth="Infinity" promptText="Selecione o tipo"
                                      styleClass="field-combo"/>
                        </VBox>

                        <!-- Categoria -->
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="Categoria"/>
                            <ComboBox fx:id="cbCategoria" maxWidth="Infinity" promptText="Categoria"
                                      styleClass="field-combo"/>
                        </VBox>

                        <!-- Data -->
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="Data"/>
                            <DatePicker fx:id="dpData" maxWidth="Infinity" styleClass="field-datepicker"/>
                        </VBox>

                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="12">

                        <!-- Descrição -->
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="Descrição"/>
                            <TextField fx:id="txtDescricao" promptText="Ex: Salário, Aluguel..."
                                       styleClass="field-input"/>
                        </VBox>

                        <!-- Valor -->
                        <VBox prefWidth="180" spacing="4">
                            <Label styleClass="field-label" text="Valor (R$)"/>
                            <TextField fx:id="txtValor" promptText="0,00" styleClass="field-input, field-valor"/>
                        </VBox>

                    </HBox>

                    <!-- Mensagem de erro -->
                    <Label fx:id="lblErro" managed="false" styleClass="error-label" text="" visible="false"/>

                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Button onAction="#handleLimpar" styleClass="btn-secondary" text="Limpar"/>
                        <Button defaultButton="true" onAction="#adicionarTransacao" styleClass="btn-primary"
                                contentDisplay="RIGHT">
                            Salvar
                            <graphic>
                                <FontIcon iconLiteral="remixal-check-fill" iconSize="18" iconColor="black"/>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>

                <!-- ── Tabela de Transações ── -->
                <VBox spacing="12" styleClass="table-card" VBox.vgrow="ALWAYS">

                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label styleClass="section-title" text="Histórico de Transações" HBox.hgrow="ALWAYS"/>

                        <!-- Barra de busca -->
                        <TextField fx:id="tfBusca" onKeyReleased="#handleBusca" prefWidth="200"
                                   promptText="🔍  Buscar..." styleClass="field-input, search-field"/>

                        <!-- Filtro tipo -->
                        <ComboBox fx:id="cbFiltroTipo" onAction="#handleFiltro" prefWidth="130" promptText="Todos"
                                  styleClass="field-combo"/>

                        <Button fx:id="btnRemover" onAction="#handleRemover" styleClass="btn-danger" text="Remover">
                            <graphic>
                                <FontIcon iconLiteral="remixal-delete-bin-fill" iconSize="12" iconColor="ff6b6b"/>
                            </graphic>
                        </Button>
                    </HBox>

                    <!-- Tabela com altura mínima para evitar que desapareça no Scroll -->
                    <TableView fx:id="tabelaTransacoes" minHeight="250.0" styleClass="transacao-table"
                               VBox.vgrow="ALWAYS">
                        <placeholder>
                            <Label text="Nenhuma transação encontrada"/>
                        </placeholder>

                        <columns>
                            <TableColumn fx:id="colData" prefWidth="110" sortable="true" text="Data"/>
                            <TableColumn fx:id="colTipo" prefWidth="100" sortable="true" text="Tipo"/>
                            <TableColumn fx:id="colCategoria" prefWidth="140" sortable="true" text="Categoria"/>
                            <TableColumn fx:id="colDescricao" prefWidth="260" sortable="true" text="Descrição"/>
                            <TableColumn fx:id="colValor" prefWidth="130" sortable="true" text="Valor"/>
                        </columns>

                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>

                    </TableView>

                    <!-- Rodapé da tabela -->
                    <HBox alignment="CENTER_LEFT" spacing="16" styleClass="table-footer">
                        <Label fx:id="lblQtdRegistros" styleClass="footer-info" text="0 registros"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label styleClass="footer-info" text="Saldo:"/>
                        <Label fx:id="lblSaldoFooter" styleClass="footer-saldo" text="R$ 0,00"/>
                    </HBox>

                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
