<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="12" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.MainController">
    <padding>
        <Insets bottom="16" left="16" right="16" top="16" />
    </padding>

    <HBox spacing="8">
        <TextField fx:id="campoDescricao" promptText="Descrição" />
        <TextField fx:id="campoValor" promptText="Valor" />
        <ComboBox fx:id="comboCategoria" promptText="Categoria" />
        <Button mnemonicParsing="false" onAction="#adicionarReceita" text="Adicionar Receita" />
        <Button mnemonicParsing="false" onAction="#adicionarDespesa" text="Adicionar Despesa" />
        <Button mnemonicParsing="false" onAction="#removerTransacaoSelecionada" text="Remover Selecionada" />
    </HBox>

    <TableView fx:id="tabelaTransacoes" prefHeight="320" prefWidth="760">
        <columns>
            <TableColumn fx:id="colunaDescricao" prefWidth="320" text="Descrição" />
            <TableColumn fx:id="colunaValor" prefWidth="200" text="Valor" />
            <TableColumn fx:id="colunaData" prefWidth="220" text="Data" />
        </columns>
    </TableView>

    <Label fx:id="labelSaldoTotal" text="Saldo total: R$ 0,00" />
</VBox>
